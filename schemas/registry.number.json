{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atep.io/schemas/1.0/registry.number.json",
  "title": "registry number response",
  "description": "Section 4.4. GET /v1/numbers/{e164}.",
  "type": "object",
  "properties": {
    "number": {
      "$ref": "common.json#/$defs/e164"
    },
    "card": {
      "$ref": "common.json#/$defs/https_url"
    },
    "party": {
      "$ref": "common.json#/$defs/id"
    },
    "verified_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "platform": {
      "$ref": "common.json#/$defs/platform_code"
    },
    "sig": {
      "description": "Section 4.4. A registry MUST serve responses signed per Section 3 with keys published in its own card.",
      "$ref": "common.json#/$defs/jws"
    }
  },
  "required": [
    "number",
    "card",
    "party",
    "verified_at",
    "sig"
  ],
  "additionalProperties": true
}
