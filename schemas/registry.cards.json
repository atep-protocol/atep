{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atep.io/schemas/1.0/registry.cards.json",
  "title": "registry cards response",
  "description": "Section 4.4. GET /v1/cards?party={id}. Returns { party, cards: [{ card, numbers, verified_at, platform }], sig }.",
  "type": "object",
  "properties": {
    "party": {
      "$ref": "common.json#/$defs/id"
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "card": {
            "$ref": "common.json#/$defs/https_url"
          },
          "numbers": {
            "type": "array",
            "items": {
              "$ref": "common.json#/$defs/e164"
            }
          },
          "verified_at": {
            "$ref": "common.json#/$defs/timestamp"
          },
          "platform": {
            "$ref": "common.json#/$defs/platform_code"
          }
        },
        "required": [
          "card",
          "verified_at"
        ],
        "additionalProperties": true
      }
    },
    "sig": {
      "description": "Section 4.4. A registry MUST serve responses signed per Section 3 with keys published in its own card.",
      "$ref": "common.json#/$defs/jws"
    }
  },
  "required": [
    "party",
    "cards",
    "sig"
  ],
  "additionalProperties": true
}
